{
    "runtime.version": "LuaJIT",
    "workspace.checkThirdParty": false,
    "diagnostics.globals": [
        "game", "workspace", "script", "plugin",
        "getgenv", "getrenv", "getreg", "getgc",
        "getinstances", "getnilinstances", "getloadedmodules",
        "getscripts", "getcallingscript", "getsenv", "getupvalues",
        "getconstants", "getproto", "getrawmetatable",
        "getnamecallmethod", "getconnections", "getcustomasset",
        "getthreadidentity", "getidentity", "getscriptable",
        "gethiddenproperty", "gethui",
        "spawn", "task", "wait", "delay", "tick", "typeof",
        "warn", "print", "Instance", "Vector2", "Vector3",
        "CFrame", "Color3", "ColorSequence", "ColorSequenceKeypoint",
        "NumberRange", "NumberSequence", "NumberSequenceKeypoint",
        "PhysicalProperties", "Ray", "Rect", "Region3", "Region3int16",
        "TweenInfo", "UDim2", "UDim", "Enum", "Faces", "Axes",
        "BrickColor", "Random", "Drawing", "loadstring",
        "writefile", "readfile", "isfile", "delfile", "listfiles",
        "makefolder", "isfolder", "delfolder", "appendfile",
        "mouse1click", "mouse1press", "mouse1release",
        "mouse2click", "mouse2press", "mouse2release",
        "mousemoverel", "mousemoveabs",
        "keypress", "keyrelease", "fireclickdetector",
        "firetouchinterest", "fireproximityprompt",
        "hookfunction", "hookmetamethod", "setreadonly",
        "checkcaller", "newcclosure", "identifyexecutor",
        "getexecutorname", "request", "http_request", "syn",
        "Krnl", "setclipboard", "toclipboard",
        "protectgui", "unprotectgui",
        "sethiddenproperty", "sethiddenproperties",
        "setscriptable", "isnetworkowner", "cloneref",
        "compareinstances", "setthreadidentity", "setidentity",
        "debug", "require", "unpack", "newproxy", "gcinfo",
        "collectgarbage", "load", "loadfile", "dofile",
        "rawequal", "rawget", "rawset", "rawlen",
        "coroutine", "string", "table", "math", "os", "io",
        "bit32", "utf8", "buffer", "vector"
    ],
    "diagnostics.disable": [
        "undefined-global",
        "lowercase-global",
        "unknown-symbol",
        "inject-field",
        "param-type-mismatch",
        "assign-type-mismatch",
        "missing-parameter",
        "redundant-parameter",
        "unbalanced-assignments",
        "need-check-nil",
        "unused-local",
        "unused-function",
        "unused-vararg",
        "unused-label",
        "undefined-field",
        "deprecated",
        "duplicate-set-field",
        "unreachable-code"
    ],
    "telemetry.enable": false,
    "type.castNumberToInteger": false,
    "type.checkTableShape": false,
    "completion.callSnippet": "Disable"
}